load("//bazel:packaged_shared_libraries.bzl", "packaged_shared_libraries")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "package_strip_fixture",
    srcs = ["package_strip_fixture.c"],
    outs = [
        "fixture/libpackage_strip_fixture.so",
        "fixture/libpackage_strip_fixture.so.1",
    ],
    cmd = """
cc -g -fPIC -shared -Wl,-soname,libpackage_strip_fixture.so.1 $(location package_strip_fixture.c) -o $(location fixture/libpackage_strip_fixture.so.1)
ln -s libpackage_strip_fixture.so.1 $(location fixture/libpackage_strip_fixture.so)
""",
    tags = ["manual"],
)

packaged_shared_libraries(
    name = "packaged_strip_fixture",
    srcs = [":package_strip_fixture"],
    out_dir = "packaged",
    strip_symbols = select({
        "//:retain_symbols": False,
        "//conditions:default": True,
    }),
    tags = ["manual"],
)

packaged_shared_libraries(
    name = "packaged_empty_fixture",
    srcs = [],
    tags = ["manual"],
)

sh_test(
    name = "packaged_shared_libraries_test",
    srcs = ["packaged_shared_libraries_test.sh"],
    args = select({
        "//:retain_symbols": ["retained"],
        "//conditions:default": ["stripped"],
    }) + [
        "$(location :fixture/libpackage_strip_fixture.so.1)",
        "$(locations :packaged_strip_fixture)",
    ],
    data = [
        ":fixture/libpackage_strip_fixture.so.1",
        ":packaged_strip_fixture",
        ":packaged_empty_fixture",
    ],
)

sh_test(
    name = "jemalloc_build_config_test",
    srcs = ["jemalloc_build_config_test.sh"],
    args = ["$(location //:jemalloc_build_config)"] + select({
        "//:enable_jemalloc_prof": ["True"],
        "//conditions:default": ["False"],
    }),
    data = ["//:jemalloc_build_config"],
)

sh_test(
    name = "worker_jemalloc_link_test",
    srcs = ["worker_jemalloc_link_test.sh"],
    args = [
        "$(location //src/datasystem/worker:datasystem_worker)",
        "$(location //:libjemalloc_shared_file)",
    ],
    data = [
        "//:libjemalloc_shared_file",
        "//src/datasystem/worker:datasystem_worker",
    ],
    tags = ["manual"],
)

cc_test(
    name = "jemalloc_profile_config_test",
    srcs = ["jemalloc_profile_config_test.cpp"],
    local_defines = select({
        "//:enable_jemalloc_prof": ["EXPECT_JEMALLOC_PROF"],
        "//conditions:default": [],
    }),
    tags = ["manual"],
    deps = select({
        "//:enable_jemalloc_prof": ["@jemalloc_kvc//:jemalloc_prof_shared"],
        "//conditions:default": ["@jemalloc_kvc//:jemalloc_shared"],
    }),
)
