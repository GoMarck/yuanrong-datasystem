{
  "protocols": {
    "datasystem": "ub",
    "mooncake": "rdma"
  },
  "systems": [
    "datasystem",
    "mooncake"
  ],
  "cluster_name": "predictor",
  "mooncake_rdma": {
    "resource": "rdma/hca",
    "device_name": "auto"
  },
  "writer_threads": 4,
  "notify_count": 1,
  "sizes": [
    "1MB"
  ],
  "target_qps": {
    "1MB": [
      17
    ]
  },
  "memory_gib": {
    "datasystem_worker": 60,
    "datasystem_pod": 336,
    "mooncake_store": 320,
    "mooncake_pod": 336,
    "client_pod": 20,
    "mooncake_client_buffer": 2
  },
  "cpus": {
    "storage": 16,
    "client": 16
  },
  "ub_resource": "unifiedbus.com/ub_net_device",
  "device_name": "auto",
  "components": {
    "datasystem": {
      "coordinator": {
        "generated": {
          "coordinator_address": "${coordinator_address}"
        },
        "config": {
          "coordinator_raft_data_dir": "/data/raft",
          "log_dir": "/data/logs"
        },
        "env": {},
        "config_file": "comparison/coordinator_config.reference.json",
        "preserve_config_template": true
      },
      "worker": {
        "config_file": "comparison/worker_config.reference.json",
        "generated": {
          "coordinator_address": "${coordinator_address}"
        },
        "config": {
          "host_id_env_name": "HOST_IP",
          "log_dir": "/data/logs",
          "unix_domain_socket_dir": "/data/uds",
          "health_check_path": "/data/probe/healthy",
          "ready_check_path": "/data/probe/ready"
        },
        "env": {},
        "preserve_config_template": true
      },
      "client": {
        "generated": {
          "coordinator_address": "${coordinator_address}"
        },
        "config": {
          "enable_local_cache": false,
          "request_timeout_ms": 20,
          "service_discovery": "coordinator",
          "host_id_env_name": "HOST_IP"
        },
        "env": {
          "DATASYSTEM_UB_GET_DATA_SIZE_BYTES": "10485760",
          "DATASYSTEM_ENABLE_LOAD_AWARE_SCHEDULER": "true"
        }
      }
    },
    "mooncake": {
      "master": {
        "generated": {
          "rpc_address": "${master_pod_ip}"
        },
        "args": {
          "rpc_port": 50051
        },
        "env": {}
      },
      "store": {
        "generated": {
          "master": "${master_address}",
          "segment_size": "${mooncake_store_bytes}",
          "local_buffer_size": "${mooncake_client_buffer_bytes}",
          "protocol": "${protocol}",
          "device_name": "${device_name}"
        },
        "args": {},
        "env": {
          "MC_SLICE_SIZE": "1048576",
          "MC_NUM_QP_PER_EP": "2",
          "MC_NUM_CQ_PER_CTX": "1",
          "MC_WORKERS_PER_CTX": "2",
          "MC_MAX_WR": "256",
          "MC_TE_METRIC": "1",
          "MC_TE_METRIC_INTERVAL_SECONDS": "5",
          "MC_STORE_CLIENT_METRIC": "1",
          "MC_STORE_CLIENT_METRIC_INTERVAL": "5"
        }
      },
      "client": {
        "generated": {
          "master_address": "${master_address}",
          "local_buffer_size": "${mooncake_client_buffer_bytes}",
          "protocol": "${protocol}",
          "device_name": "${device_name}"
        },
        "config": {},
        "env": {
          "MC_SLICE_SIZE": "1048576",
          "MC_NUM_QP_PER_EP": "2",
          "MC_NUM_CQ_PER_CTX": "1",
          "MC_WORKERS_PER_CTX": "2",
          "MC_MAX_WR": "256",
          "MC_TE_METRIC": "1",
          "MC_TE_METRIC_INTERVAL_SECONDS": "5",
          "MC_STORE_CLIENT_METRIC": "1",
          "MC_STORE_CLIENT_METRIC_INTERVAL": "5"
        }
      }
    }
  },
  "client_numa_node": null,
  "client_cpu_limit": 32,
  "reader_threads": 8,
  "deployment": {
    "mode": "kubernetes",
    "clients": {
      "worker02": 2,
      "worker03": 2
    },
    "datasystem": {
      "coordinator": {
        "master": 1
      },
      "worker": {
        "worker02": 1,
        "worker03": 1
      }
    },
    "mooncake": {
      "master": {
        "master": 1
      },
      "store": {
        "worker02": 1,
        "worker03": 1
      }
    }
  },
  "run": {
    "duration_seconds": 60,
    "cleanup_on_success": true,
    "ttl_seconds": 10,
    "service_settle_seconds": 20,
    "output_root": "results"
  },
  "artifacts": {
    "pod_image": "mooncake-store-kvtest:official-v0.3.13.post1-rdma-event",
    "datasystem_config_image": "docker.io/library/kvcache:B043-85b27d03e",
    "kvtest_binary": "output/kvtest"
  },
  "notify_include_self": false
}
