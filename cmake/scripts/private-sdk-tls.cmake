file(STRINGS "${PACKAGE}/tls-inputs.txt" archives)
set(initializers)
foreach(archive IN LISTS archives)
    execute_process(COMMAND "${NM}" --undefined-only --format=posix "${archive}"
        OUTPUT_VARIABLE undefined COMMAND_ERROR_IS_FATAL ANY)
    string(REGEX MATCHALL "(^|\n)_ZTH[A-Za-z0-9_]+[ \t]+w" matches "${undefined}")
    foreach(match IN LISTS matches)
        string(REGEX MATCH "_ZTH[A-Za-z0-9_]+" symbol "${match}")
        list(APPEND initializers "${symbol}")
    endforeach()
endforeach()
list(REMOVE_DUPLICATES initializers)
list(SORT initializers)
set(source "")
foreach(symbol IN LISTS initializers)
    string(APPEND source "extern \"C\" void ${symbol}() __attribute__((weak, visibility(\"hidden\")));\n"
        "namespace { __attribute__((used)) auto* const ref${symbol} = &${symbol}; }\n")
endforeach()
file(WRITE "${PACKAGE}/tls.cpp" "${source}")
