if (BUILD_PIPLN_H2D)
    if (NOT BUILD_WITH_URMA AND NOT BUILD_WITH_URMA_MOCK)
        message(FATAL_ERROR "BUILD_PIPLN_H2D requires BUILD_WITH_URMA or BUILD_WITH_URMA_MOCK")
    endif()
    include(${DS_SOURCE_DIR}/cmake/external_libs/pipeline_rh2d.cmake)
endif()

if (BUILD_WITH_URMA_MOCK)
    if (BUILD_WITH_URMA)
        message(FATAL_ERROR "BUILD_WITH_URMA_MOCK and BUILD_WITH_URMA are mutually exclusive (mock backend is for dev/CI without liburma.so)")
    endif()
    message(STATUS "Build with urma mock (local shm+UDS backend, no SDK needed)")
    add_compile_definitions(USE_URMA USE_URMA_MOCK)
endif()
