function(ds_client_canonical canonical selected)
    if (NOT TARGET "${canonical}")
        add_library("${canonical}" ALIAS "${selected}")
    else()
        get_target_property(_canonical "${canonical}" ALIASED_TARGET)
        get_target_property(_selected "${selected}" ALIASED_TARGET)
        if (NOT _canonical)
            set(_canonical "${canonical}")
        endif()
        if (NOT _selected)
            set(_selected "${selected}")
        endif()
        if (NOT _canonical STREQUAL _selected)
            message(FATAL_ERROR "${canonical} and selected target ${selected} name different implementations")
        endif()
    endif()
endfunction()
