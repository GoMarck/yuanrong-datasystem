# Existing targets take precedence; package discovery never builds dependencies.
function(ds_client_dependency key package minimum)
    set(_mapping "DS_${key}_TARGET")
    set(${_mapping} "${${_mapping}}" CACHE STRING "Host target for ${package}")
    set(_target "${${_mapping}}")
    if (_target AND NOT TARGET "${_target}")
        message(FATAL_ERROR "${_mapping}=${_target} is not an existing CMake target")
    endif()
    if (NOT _target)
        foreach(_candidate ${ARGN})
            if (TARGET "${_candidate}")
                set(_target "${_candidate}")
                break()
            endif()
        endforeach()
    endif()
    if (NOT _target)
        if (package MATCHES "^(OpenSSL|ZLIB|CURL)$")
            find_package(${package} QUIET)
        else()
            find_package(${package} QUIET CONFIG)
        endif()
        foreach(_candidate ${ARGN})
            if (TARGET "${_candidate}")
                set(_target "${_candidate}")
                break()
            endif()
        endforeach()
    endif()
    if (NOT _target)
        message(FATAL_ERROR
            "External dependency ${package} is missing. Provide ${ARGN}, set ${_mapping}, "
            "or set ${package}_DIR/CMAKE_PREFIX_PATH. DS will not build a private copy.")
    endif()
    set(_version "${DS_${key}_VERSION}")
    if (NOT _version)
        get_target_property(_version "${_target}" DS_DEPENDENCY_VERSION)
    endif()
    if (NOT _version)
        string(TOUPPER "${package}" _package_upper)
        foreach(_variable ${package}_VERSION ${package}_VERSION_STRING ${_package_upper}_VERSION)
            if (DEFINED ${_variable})
                set(_version "${${_variable}}")
                break()
            endif()
        endforeach()
    endif()
    if (NOT _version)
        message(FATAL_ERROR
            "Version of ${_target} is unknown. Set DS_${key}_VERSION or its DS_DEPENDENCY_VERSION property.")
    endif()
    string(REGEX REPLACE "^v" "" _normalized "${_version}")
    string(REPLACE "-" "." _normalized "${_normalized}")
    if (_normalized VERSION_LESS minimum)
        message(FATAL_ERROR "${package} ${_version} is below the integration floor ${minimum}")
    endif()
    message(STATUS "DS external ${key}: ${_target} (${_version})")
    set(DS_${key}_TARGET "${_target}" PARENT_SCOPE)
    set(DS_${key}_VERSION "${_version}" PARENT_SCOPE)
endfunction()

function(ds_client_tool variable default_target)
    if (NOT ${variable})
        set(${variable} "${default_target}")
    endif()
    if (NOT TARGET "${${variable}}")
        message(FATAL_ERROR "${variable} must name an existing executable target (${default_target})")
    endif()
    get_target_property(_type "${${variable}}" TYPE)
    if (NOT _type STREQUAL "EXECUTABLE")
        message(FATAL_ERROR "${variable}=${${variable}} is not an executable target")
    endif()
    if (CMAKE_CROSSCOMPILING)
        get_target_property(_host "${${variable}}" IMPORTED)
        if (NOT _host OR "${${variable}}" STREQUAL "${default_target}")
            message(FATAL_ERROR "Cross compilation requires an explicit imported host tool: ${variable}")
        endif()
    endif()
    set(${variable} "${${variable}}" PARENT_SCOPE)
endfunction()

