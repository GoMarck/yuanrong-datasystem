foreach(_required protobuf::libprotobuf gRPC::grpc++ absl::symbolize
        absl::failure_signal_handler OpenSSL::SSL OpenSSL::Crypto re2::re2 CURL::libcurl
        nlohmann_json::nlohmann_json)
    if (NOT TARGET "${_required}")
        message(FATAL_ERROR "External mode requires canonical target ${_required}; alias your host target to it")
    endif()
endforeach()

if (NOT CMAKE_CROSSCOMPILING AND NOT TARGET protobuf::libprotoc)
    message(FATAL_ERROR "Native DS protocol generator requires protobuf::libprotoc from the selected protobuf")
endif()

get_target_property(_tbb_yield "${DS_TBB_TARGET}" DS_TBB_BTHREAD_AWARE_YIELD)
if (NOT _tbb_yield)
    message(FATAL_ERROR
        "${DS_TBB_TARGET} requires DS_TBB_BTHREAD_AWARE_YIELD=TRUE: use the repository TBB "
        "2020.3 bthread-aware-yield.patch or a verified equivalent; plain sched_yield can starve bthreads")
endif()

get_target_property(DS_BRPC_LOGGING "${DS_BRPC_TARGET}" DS_BRPC_LOGGING)
if (NOT DS_BRPC_LOGGING MATCHES "^(GLOG|RENAMED_BUTIL)$")
    message(FATAL_ERROR
        "${DS_BRPC_TARGET} must declare DS_BRPC_LOGGING=GLOG or RENAMED_BUTIL; "
        "unpatched WITH_GLOG=OFF collides with host glog flags")
endif()
foreach(_contract DS_BRPC_NO_PTHREAD_MUTEX_HOOK DS_BRPC_USES_HOST_DEPS)
    get_target_property(_value "${DS_BRPC_TARGET}" ${_contract})
    if (NOT _value)
        message(FATAL_ERROR "${DS_BRPC_TARGET} must attest ${_contract}=TRUE; see docs/client-source-integration.md")
    endif()
endforeach()

ds_client_tool(DS_HOST_PROTOC_TARGET protobuf::protoc)
ds_client_tool(DS_HOST_GRPC_PLUGIN_TARGET gRPC::grpc_cpp_plugin)
if (CMAKE_CROSSCOMPILING)
    ds_client_tool(DS_HOST_ZMQ_PLUGIN_TARGET ds_client_zmq_plugin)
endif()
set(DS_PROTOC_TARGET "${DS_HOST_PROTOC_TARGET}")
set(DS_GRPC_PLUGIN_TARGET "${DS_HOST_GRPC_PLUGIN_TARGET}")

set(BRPC_LIBRARY "${DS_BRPC_TARGET}")
set(BRPC_LIBRARIES "${DS_BRPC_TARGET};${DS_GFLAGS_TARGET};${DS_LEVELDB_TARGET};protobuf::libprotobuf;Threads::Threads")
set(PROTOBUF_LIBRARIES protobuf::libprotobuf)
set(ZLIB_LIBRARIES "${DS_ZLIB_TARGET}")
set(OPENSSL_LIBRARIES "OpenSSL::SSL;OpenSSL::Crypto")
set(TBB_LIBRARY "${DS_TBB_TARGET}")
set(SECUREC_LIBRARY "${DS_SECUREC_TARGET}")
set(DS_CLIENT_EXTERNAL_LIBRARIES
    ${BRPC_LIBRARIES} ${ZLIB_LIBRARIES} ${OPENSSL_LIBRARIES} ${TBB_LIBRARY} ${SECUREC_LIBRARY}
    gRPC::grpc++ absl::symbolize absl::failure_signal_handler re2::re2 CURL::libcurl
    ${DS_ZMQ_TARGET} ${DS_CARES_TARGET} nlohmann_json::nlohmann_json)

get_target_property(_plugin_version "${DS_GRPC_PLUGIN_TARGET}" DS_DEPENDENCY_VERSION)
if (DS_HOST_GRPC_PLUGIN_VERSION)
    set(_plugin_version "${DS_HOST_GRPC_PLUGIN_VERSION}")
endif()
if (NOT _plugin_version OR NOT _plugin_version VERSION_EQUAL DS_GRPC_VERSION)
    message(FATAL_ERROR "Host grpc_cpp_plugin version (${_plugin_version}) must match gRPC ${DS_GRPC_VERSION}")
endif()
get_target_property(_protoc_imported "${DS_PROTOC_TARGET}" IMPORTED)
if (_protoc_imported)
    get_target_property(_protoc_location "${DS_PROTOC_TARGET}" IMPORTED_LOCATION)
    if (NOT _protoc_location)
        get_target_property(_protoc_location "${DS_PROTOC_TARGET}" IMPORTED_LOCATION_RELEASE)
    endif()
    if (NOT _protoc_location)
        message(FATAL_ERROR "Imported host protoc must specify IMPORTED_LOCATION or IMPORTED_LOCATION_RELEASE")
    endif()
    include("${DS_SOURCE_DIR}/cmake/check-client-codegen.cmake")
    ds_check_protoc("${_protoc_location}" "${DS_PROTOBUF_VERSION}")
endif()
