function(ds_check_protoc executable runtime_version)
    # C++ runtime 3.25.5 / 4.25.5 / 25.5.0 all use protoc 25.5.
    string(REGEX MATCHALL "[0-9]+" _parts "${runtime_version}")
    list(LENGTH _parts _length)
    list(GET _parts 0 _major)
    list(GET _parts 1 _minor)
    set(_expected "${runtime_version}")
    if (_major LESS 6 AND _minor GREATER_EQUAL 22 AND _length GREATER_EQUAL 3)
        list(GET _parts 2 _patch)
        set(_expected "${_minor}.${_patch}")
    elseif (_major GREATER_EQUAL 22)
        set(_expected "${_major}.${_minor}")
    endif()
    execute_process(COMMAND "${executable}" --version
        RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error OUTPUT_STRIP_TRAILING_WHITESPACE)
    string(REGEX REPLACE "^libprotoc +" "" _actual "${_output}")
    if (NOT _result EQUAL 0 OR NOT _actual VERSION_EQUAL _expected)
        message(FATAL_ERROR "Selected protoc ${executable}: '${_output}' (${_error}); expected ${_expected} for runtime ${runtime_version}")
    endif()
endfunction()
if (DEFINED DS_CHECK_PROTOC)
    ds_check_protoc("${DS_CHECK_PROTOC}" "${DS_CHECK_PROTOBUF_VERSION}")
endif()
