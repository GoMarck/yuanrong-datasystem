function(ds_static_sdk_jobs output fallback)
    set(jobs "${DS_STATIC_SDK_JOBS}")
    if (jobs STREQUAL "")
        set(jobs "$ENV{CMAKE_BUILD_PARALLEL_LEVEL}")
    endif()
    if (jobs STREQUAL "")
        set(jobs "${fallback}")
    endif()
    if (NOT jobs MATCHES "^[1-9][0-9]*$")
        message(FATAL_ERROR "Static SDK build parallelism must be a positive integer, got '${jobs}'")
    endif()
    set(${output} "${jobs}" PARENT_SCOPE)
endfunction()
