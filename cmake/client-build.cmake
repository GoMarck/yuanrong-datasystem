function(ds_configure_client_targets directory)
    get_property(_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(_target ${_targets})
        get_target_property(_type "${_target}" TYPE)
        get_target_property(_links "${_target}" LINK_LIBRARIES)
        foreach(_link ${_links})
            if (NOT _link MATCHES "[-/\\$<>]" AND NOT _link MATCHES "^(dl|pthread|rt|m|atomic)$"
                    AND NOT _link MATCHES "-NOTFOUND$" AND NOT TARGET "${_link}")
                message(FATAL_ERROR "Client closure target ${_target} has unresolved dependency ${_link}")
            endif()
        endforeach()
        if (NOT _type MATCHES "^(INTERFACE_LIBRARY|UTILITY)$")
            target_include_directories("${_target}" PRIVATE
                "${DS_SOURCE_DIR}/include" "${DS_SOURCE_DIR}/src" "${DS_BINARY_DIR}/src"
                "${DS_BINARY_DIR}/third_party/protos")
            target_link_libraries("${_target}" PRIVATE ds_client_build_options)
            target_compile_features("${_target}" PRIVATE cxx_std_17)
            target_compile_options("${_target}" PRIVATE -fsigned-char)
        endif()
    endforeach()
    get_property(_children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(_child ${_children})
        ds_configure_client_targets("${_child}")
    endforeach()
endfunction()
ds_configure_client_targets("${DS_SOURCE_DIR}")
