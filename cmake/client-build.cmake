function(ds_client_target_report directory)
    get_property(_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(_target ${_targets})
        get_target_property(_type "${_target}" TYPE)
        get_target_property(_links "${_target}" LINK_LIBRARIES)
        get_target_property(_interface "${_target}" INTERFACE_LINK_LIBRARIES)
        file(APPEND "${DS_BINARY_DIR}/client-targets.txt" "${_target}|${_type}|${_links}|${_interface}\n")
    endforeach()
    get_property(_children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(_child ${_children})
        ds_client_target_report("${_child}")
    endforeach()
endfunction()
file(WRITE "${DS_BINARY_DIR}/client-targets.txt" "target|type|links|interface_links\n")
ds_client_target_report("${DS_SOURCE_DIR}")

