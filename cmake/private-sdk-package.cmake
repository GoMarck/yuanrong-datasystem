include(CMakePackageConfigHelpers)

function(ds_private_sdk_origin path)
    get_property(_prefixes GLOBAL PROPERTY DS_PRIVATE_SDK_PREFIXES)
    get_filename_component(_path "${path}" REALPATH)
    foreach(_prefix ${_prefixes})
        get_filename_component(_prefix "${_prefix}" REALPATH)
        file(RELATIVE_PATH _relative "${_prefix}" "${_path}")
        if (NOT _relative MATCHES "^\\.\\.(/|$)" AND NOT IS_ABSOLUTE "${_relative}")
            return()
        endif()
    endforeach()
    message(FATAL_ERROR "Private SDK dependency escaped its DS-owned prefixes: ${path}")
endfunction()

function(ds_private_sdk_identifier input output)
    string(MAKE_C_IDENTIFIER "${input}" _name)
    string(LENGTH "${_name}" _length)
    if (_length GREATER 60)
        string(SUBSTRING "${_name}" 0 60 _name)
    endif()
    string(SHA256 _hash "${input}")
    string(SUBSTRING "${_hash}" 0 12 _hash)
    set(${output} "${_name}_${_hash}" PARENT_SCOPE)
endfunction()

function(ds_private_sdk_archive source identifier output)
    set(_id "${identifier}")
    if (NOT source MATCHES "^\\$<TARGET_FILE:")
        if (NOT IS_ABSOLUTE "${source}" OR NOT EXISTS "${source}" OR NOT source MATCHES "\\.a$")
            message(FATAL_ERROR "Private SDK requires a real static archive, got: ${source}")
        endif()
        ds_private_sdk_origin("${source}")
        get_filename_component(source "${source}" REALPATH)
        get_filename_component(_basename "${source}" NAME_WE)
        string(SHA256 _hash "archive:${source}")
        string(SUBSTRING "${_hash}" 0 16 _hash)
        string(LENGTH "${_basename}" _length)
        if (_length GREATER 48)
            string(SUBSTRING "${_basename}" 0 48 _basename)
        endif()
        set(_id "a_${_basename}_${_hash}")
    endif()
    set(_target "DatasystemPrivate::${_id}")
    get_property(_known GLOBAL PROPERTY "DS_PRIVATE_ARCHIVE_${_id}")
    if (NOT _known)
        set_property(GLOBAL PROPERTY "DS_PRIVATE_ARCHIVE_${_id}" TRUE)
        set(_filename "libds_private_${_id}.a")
        set_property(GLOBAL APPEND_STRING PROPERTY DS_PRIVATE_DECLARATIONS
            "add_library(${_target} STATIC IMPORTED)\nset_target_properties(${_target} PROPERTIES IMPORTED_LOCATION \"\${_DS_PRIVATE_PREFIX}/lib/datasystem-private/${_filename}\")\n")
        install(CODE "file(READ \"${source}\" _ds_archive_magic LIMIT 8)\nif(NOT _ds_archive_magic STREQUAL \"!<arch>\\n\")\nmessage(FATAL_ERROR \"Private SDK requires a full archive (no thin archives): ${source}\")\nendif()")
        install(FILES "${source}" DESTINATION lib/datasystem-private RENAME "${_filename}")
        set_property(GLOBAL APPEND PROPERTY DS_PRIVATE_ARCHIVES "${_filename}")
    endif()
    set(${output} "${_target}" PARENT_SCOPE)
endfunction()

function(ds_private_sdk_location target output)
    string(TOUPPER "${CMAKE_BUILD_TYPE}" _configuration)
    get_target_property(_mapped "${target}" "MAP_IMPORTED_CONFIG_${_configuration}")
    set(_configs "${_configuration}")
    if (_mapped)
        list(PREPEND _configs ${_mapped})
    endif()
    get_target_property(_available "${target}" IMPORTED_CONFIGURATIONS)
    if (_available)
        list(APPEND _configs ${_available})
    endif()
    foreach(_config ${_configs})
        string(TOUPPER "${_config}" _config)
        get_target_property(_location "${target}" "IMPORTED_LOCATION_${_config}")
        if (_location)
            set(${output} "${_location}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    get_target_property(_location "${target}" IMPORTED_LOCATION)
    if (NOT _location)
        message(FATAL_ERROR "No static archive location for ${target}")
    endif()
    set(${output} "${_location}" PARENT_SCOPE)
endfunction()

function(ds_private_sdk_link item output)
    if (NOT item OR item MATCHES "-NOTFOUND$" OR item MATCHES "^::@(\\([^)]*\\))?$")
        set(${output} "" PARENT_SCOPE)
        return()
    endif()
    string(REGEX MATCHALL "\\$<BOOL:[^<>$]*>" _booleans "${item}")
    foreach(_boolean ${_booleans})
        string(REGEX REPLACE "^\\$<BOOL:(.*)>$" "\\1" _value "${_boolean}")
        if (_value)
            set(_constant 1)
        else()
            set(_constant 0)
        endif()
        string(REPLACE "${_boolean}" "${_constant}" item "${item}")
    endforeach()
    if (item MATCHES "^\\$<([01]):(.*)>$")
        set(_condition "${CMAKE_MATCH_1}")
        set(_body "${CMAKE_MATCH_2}")
        set(_mapped "")
        if (_condition STREQUAL "1")
            ds_private_sdk_link("${_body}" _mapped)
        endif()
        set(${output} "${_mapped}" PARENT_SCOPE)
        return()
    endif()
    if (TARGET "${item}")
        ds_private_sdk_target("${item}" _mapped)
    elseif (IS_ABSOLUTE "${item}")
        ds_private_sdk_archive("${item}" unused _mapped)
    elseif (item MATCHES "^\\$<(LINK_ONLY|BUILD_INTERFACE):(.*)>$")
        ds_private_sdk_link("${CMAKE_MATCH_2}" _mapped)
    elseif (item MATCHES "^\\$<INSTALL_INTERFACE:")
        set(_mapped "")
    elseif (item MATCHES "^\\$<TARGET_NAME_IF_EXISTS:(.*)>$")
        if (TARGET "${CMAKE_MATCH_1}")
            ds_private_sdk_target("${CMAKE_MATCH_1}" _mapped)
        else()
            set(_mapped "")
        endif()
    elseif (item MATCHES "\\$<")
        set(_mapped "${item}")
        string(REPLACE "::" "@@" _tokens "${item}")
        string(REGEX REPLACE "[\\$<>:,;]" ";" _tokens "${_tokens}")
        foreach(_token ${_tokens})
            string(REPLACE "@@" "::" _token "${_token}")
            if (TARGET "${_token}")
                ds_private_sdk_target("${_token}" _private)
                string(REPLACE "${_token}" "${_private}" _mapped "${_mapped}")
            elseif (_token MATCHES "::")
                message(FATAL_ERROR "Unresolved private SDK target in ${item}: ${_token}")
            endif()
        endforeach()
    elseif (item MATCHES "^(dl|pthread|rt|m|atomic|resolv|c|stdc\\+\\+|gcc_s)$" OR item MATCHES "^-")
        set(_mapped "${item}")
    else()
        message(FATAL_ERROR "Unresolved private SDK link dependency: ${item}")
    endif()
    if (_mapped MATCHES "(^|[;,>: ])(/|-[LI]/)|,-rpath[,=]|\\.so([.;>,]|$)")
        message(FATAL_ERROR "Non-relocatable or shared dependency in private SDK: ${_mapped}")
    endif()
    string(REGEX MATCHALL "(^|[;,>: ])-l[^;,> ]+" _search_libraries "${_mapped}")
    foreach(_search ${_search_libraries})
        string(REGEX REPLACE "^.*-l" "" _library "${_search}")
        if (NOT _library MATCHES "^(dl|pthread|rt|m|atomic|resolv|c|stdc\\+\\+|gcc_s)$")
            message(FATAL_ERROR "Private SDK cannot search for an unmanaged library: ${_mapped}")
        endif()
    endforeach()
    set(${output} "${_mapped}" PARENT_SCOPE)
endfunction()

function(ds_private_sdk_target target output)
    get_target_property(_alias "${target}" ALIASED_TARGET)
    if (_alias)
        set(target "${_alias}")
    endif()
    ds_private_sdk_identifier("${target}" _id)
    if (target STREQUAL DS_PRIVATE_ROOT_TARGET)
        set(_id client)
    endif()
    set(_private "DatasystemPrivate::${_id}")
    set(${output} "${_private}" PARENT_SCOPE)
    get_property(_known GLOBAL PROPERTY "DS_PRIVATE_TARGET_${_id}")
    if (_known)
        return()
    endif()
    set_property(GLOBAL PROPERTY "DS_PRIVATE_TARGET_${_id}" TRUE)
    get_target_property(_type "${target}" TYPE)
    get_target_property(_imported "${target}" IMPORTED)
    if (_type STREQUAL "SHARED_LIBRARY" OR _type STREQUAL "MODULE_LIBRARY")
        message(FATAL_ERROR "Private SDK cannot contain shared target ${target}")
    endif()
    if (_imported AND NOT target STREQUAL "Threads::Threads")
        get_target_property(_includes "${target}" INTERFACE_INCLUDE_DIRECTORIES)
        foreach(_include ${_includes})
            if (_include MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
                set(_include "${CMAKE_MATCH_1}")
            elseif (_include MATCHES "^\\$<INSTALL_INTERFACE:")
                continue()
            endif()
            if (_include AND NOT _include MATCHES "-NOTFOUND$")
                ds_private_sdk_origin("${_include}")
            endif()
        endforeach()
    endif()
    set(_links)
    set(_link_owner "${_private}")
    if (target STREQUAL "Threads::Threads")
        set(_links Threads::Threads)
    elseif (_type STREQUAL "STATIC_LIBRARY" AND NOT _imported)
        ds_private_sdk_archive("$<TARGET_FILE:${target}>" "${_id}" _archive)
    else()
        if (_type STREQUAL "STATIC_LIBRARY" OR _type STREQUAL "UNKNOWN_LIBRARY")
            ds_private_sdk_location("${target}" _location)
            ds_private_sdk_archive("${_location}" unused _archive)
            set(_link_owner "${_archive}")
            set_property(GLOBAL APPEND_STRING PROPERTY DS_PRIVATE_DECLARATIONS
                "add_library(${_private} ALIAS ${_archive})\n")
        elseif (_type STREQUAL "INTERFACE_LIBRARY" OR _type STREQUAL "OBJECT_LIBRARY")
            set_property(GLOBAL APPEND_STRING PROPERTY DS_PRIVATE_DECLARATIONS
                "add_library(${_private} INTERFACE IMPORTED)\n")
        else()
            message(FATAL_ERROR "Unsupported target ${target} (${_type}) in private SDK")
        endif()
    endif()
    if (target STREQUAL "Threads::Threads")
        set_property(GLOBAL APPEND_STRING PROPERTY DS_PRIVATE_DECLARATIONS
            "add_library(${_private} INTERFACE IMPORTED)\n")
    else()
        foreach(_property INTERFACE_LINK_LIBRARIES LINK_LIBRARIES)
            get_target_property(_items "${target}" "${_property}")
            foreach(_item ${_items})
                ds_private_sdk_link("${_item}" _mapped)
                if (_mapped)
                    list(APPEND _links "${_mapped}")
                endif()
            endforeach()
        endforeach()
        get_target_property(_options "${target}" INTERFACE_LINK_OPTIONS)
        set(_private_options)
        foreach(_option ${_options})
            ds_private_sdk_link("${_option}" _mapped)
            list(APPEND _private_options "${_mapped}")
        endforeach()
        if (_private_options)
            set_property(GLOBAL APPEND_STRING PROPERTY DS_PRIVATE_PROPERTIES
                "set_property(TARGET ${_link_owner} APPEND PROPERTY INTERFACE_LINK_OPTIONS [==[${_private_options}]==])\n")
        endif()
    endif()
    if (_links)
        list(REMOVE_DUPLICATES _links)
        set_property(GLOBAL APPEND_STRING PROPERTY DS_PRIVATE_PROPERTIES
            "set_property(TARGET ${_link_owner} APPEND PROPERTY INTERFACE_LINK_LIBRARIES [==[${_links}]==])\n")
    endif()
endfunction()

function(ds_install_private_sdk root)
    get_property(_created GLOBAL PROPERTY DS_PRIVATE_SDK_PACKAGE_CREATED)
    if (_created)
        message(FATAL_ERROR "Only one private SDK package can be installed per build")
    endif()
    set_property(GLOBAL PROPERTY DS_PRIVATE_SDK_PACKAGE_CREATED TRUE)
    set(DS_PRIVATE_ROOT_TARGET "${root}")
    set_property(GLOBAL PROPERTY DS_PRIVATE_DECLARATIONS "")
    set_property(GLOBAL PROPERTY DS_PRIVATE_PROPERTIES "")
    set_property(GLOBAL PROPERTY DS_PRIVATE_ARCHIVES "")
    ds_private_sdk_target("${root}" _client)
    get_property(_declarations GLOBAL PROPERTY DS_PRIVATE_DECLARATIONS)
    get_property(_properties GLOBAL PROPERTY DS_PRIVATE_PROPERTIES)
    set(_targets "if(TARGET DatasystemPrivate::client)\n    return()\nendif()\n${_declarations}${_properties}")
    string(APPEND _targets "set_target_properties(DatasystemPrivate::client PROPERTIES INTERFACE_INCLUDE_DIRECTORIES \"\${_DS_PRIVATE_PREFIX}/include\" INTERFACE_COMPILE_FEATURES cxx_std_17 INTERFACE_POSITION_INDEPENDENT_CODE TRUE)\n")
    if (NOT "${DS_GLIBCXX_USE_CXX11_ABI}" STREQUAL "")
        string(APPEND _targets "set_property(TARGET DatasystemPrivate::client PROPERTY INTERFACE_COMPILE_DEFINITIONS _GLIBCXX_USE_CXX11_ABI=${DS_GLIBCXX_USE_CXX11_ABI})\n")
    endif()
    set(_package "${CMAKE_CURRENT_BINARY_DIR}/private-sdk-package")
    file(MAKE_DIRECTORY "${_package}")
    file(WRITE "${_package}/DatasystemPrivateTargets.cmake" "${_targets}")
    configure_package_config_file("${DS_SOURCE_DIR}/cmake/DatasystemPrivateConfig.cmake.in"
        "${_package}/DatasystemPrivateConfig.cmake" INSTALL_DESTINATION lib/cmake/DatasystemPrivate)
    write_basic_package_version_file("${_package}/DatasystemPrivateConfigVersion.cmake"
        VERSION "${DATASYSTEM_VERSION}" COMPATIBILITY SameMajorVersion)
    install(FILES "${_package}/DatasystemPrivateConfig.cmake" "${_package}/DatasystemPrivateConfigVersion.cmake"
        "${_package}/DatasystemPrivateTargets.cmake" DESTINATION lib/cmake/DatasystemPrivate)
    install(DIRECTORY "${DS_SOURCE_DIR}/include/datasystem" DESTINATION include
        FILES_MATCHING PATTERN "*.h" PATTERN "perf_client.h" EXCLUDE)
    get_property(_archives GLOBAL PROPERTY DS_PRIVATE_ARCHIVES)
    string(REPLACE ";" "\n" _archives "${_archives}")
    file(WRITE "${_package}/archives.txt" "${_archives}\n")
    install(FILES "${_package}/archives.txt" DESTINATION share/datasystem-private)
    if (EXISTS "${DS_BINARY_DIR}/private-sdk-dependencies.txt")
        install(FILES "${DS_BINARY_DIR}/private-sdk-dependencies.txt" DESTINATION share/datasystem-private)
    endif()
    execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY "${DS_SOURCE_DIR}"
        OUTPUT_VARIABLE _commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(COMMAND git branch --show-current WORKING_DIRECTORY "${DS_SOURCE_DIR}"
        OUTPUT_VARIABLE _branch OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(COMMAND git status --porcelain --untracked-files=normal WORKING_DIRECTORY "${DS_SOURCE_DIR}"
        OUTPUT_VARIABLE _dirty OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if (_dirty)
        set(_dirty TRUE)
    else()
        set(_dirty FALSE)
    endif()
    file(WRITE "${_package}/build-info.txt"
        "VERSION=${DATASYSTEM_VERSION}\nBASE_COMMIT=${_commit}\nBRANCH=${_branch}\nWORKTREE_DIRTY=${_dirty}\nCOMPILER=${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}\nGLIBCXX_ABI=${DS_GLIBCXX_USE_CXX11_ABI}\n")
    install(FILES "${_package}/build-info.txt" DESTINATION share/datasystem-private)
    install(FILES "${DS_SOURCE_DIR}/LICENSE" DESTINATION share/datasystem-private)
endfunction()
